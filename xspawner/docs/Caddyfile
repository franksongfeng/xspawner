    # 1.2 如果 example.com 没有公网证书，用内部 CA 认证
    # tls internal

    # 1.3 不加 tls 命令，使用自申请的公网免费证书


    # 2. 路由

    # 2.1 首页跳转
    # redir / /services/main 302

    # 2.2 带尾斜杠跳转
    # @add_trailing_slash {
    #     path_regexp ^/services/([^/]+)$
    # }
    # redir @add_trailing_slash /services/{re.1}/ 308


    # 2.3 静态注入 /services/admin → 127.0.0.1:<port>
    # handle_path /services/admin/* {
    #     reverse_proxy 127.0.0.1:<port>
    # }

    # 2.4 动态注入 /services/<app_id>/* （插在这里之前）


    # 3. 兜底处理
    # 3.1 将未匹配的请求代理到请求的端口
    # reverse_proxy * 127.0.0.1:<port>
    
    # 3.2 不处理
    # 未匹配的路径一律 404
    handle {
        respond "Not Found" 404
    }
}