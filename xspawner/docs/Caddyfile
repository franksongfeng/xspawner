{
    admin 127.0.0.1:2019
}


# 内网：IP + /xspawner 前缀，剥离后转发
http://192.168.77.17 {
    # /xspawner 补尾斜杠，让 handle_path 的 /xspawner/* 能匹配
    redir /xspawner /xspawner/ 308

    # 匹配 /xspawner/*，剥离 /xspawner 后转发
    handle_path /xspawner/* {
        reverse_proxy 127.0.0.1:8000
    }

    # 其余路径一律 404，防止绕过 /xspawner 直连服务
    handle {
        respond "Not Found" 404
    }
}