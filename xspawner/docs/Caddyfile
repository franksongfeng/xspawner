{
    admin 127.0.0.1:2019
    # 可选：关闭 80→443 自动重定向，只保留 443 server
    # auto_https disable_redirects
}


https://example.com {

    # 1. 证书

    # 1.1 如果 example.com 有公网证书，使用 tls 指定 SSL/TLS 证书文件和私钥文件
