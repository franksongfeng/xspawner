{
    admin 127.0.0.1:2019
    # 可选：关闭 80→443 自动重定向，只保留 443 server
    # auto_https disable_redirects
}


https://example.com {
    # 如果 example.com 使用自申请的公网免费证书，不要加 tls 命令
    # 如果 example.com 有公网可验证的证书
    # tls /path/to/your/certificate.crt /path/to/your/private.key
    # 如果 example.com 没有公网可验证的证书，用 internal CA
    # tls internal

    # 静态注入 /services/admin → 127.0.0.1:8000
    # redir /services/admin /services/admin/ 308
    # handle_path /services/admin/* {
    #     reverse_proxy 127.0.0.1:8000
    # }

    # 动态注入的 /services/{app_id}/* 插在这里之前

    # 如果子服务 access 为 0.0.0.0 的话，
    # 未注入的子服务仍可以直连端口 http://example.com:{port}
    
    # 未匹配的路径一律 404
    handle {
        respond "Not Found" 404
    }
}